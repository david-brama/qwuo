{
  "tasks": {
    "start": "deno run -P main.ts",
    "start:tunnel": "./scripts/start-with-tunnel.sh",
    "dev": "deno run -P --watch main.ts",
    "test": "deno test -A src/"
  },
  "permissions": {
    "default": {
      "net": true,
      "write": ["./.qwuo"],
      "read": ["quiz.json", "logo.png", "./.qwuo", "./node_modules"],
      "env": [
        "QUIZ_PATH",
        "QUIZ_FILTER",
        "PUBLIC_URL",
        "SESSIONS_DIR",
        "SESSION_ID",
        "SESSION_FRESH",
        "PROJECTOR_PORT",
        "PLAYER_PORT"
      ]
    }
  },
  "nodeModulesDir": "auto",
  "imports": {
    "marked": "npm:marked@15",
    "dompurify": "npm:dompurify@3"
  },
  "compilerOptions": {
    "strict": true,
    "lib": ["deno.window", "deno.unstable"]
  }
}
